# ============================================================
#  LLM 配置模板
#  使用方法：复制本文件为 .env，填入你自己的密钥
#      cp .env.example .env
#  .env 已被 .gitignore 排除，不会被提交到仓库
# ============================================================

# ---- 方式一：DeepSeek 官方 ----
LLM_PROVIDER=deepseek
LLM_API_KEY=your_deepseek_api_key_here
LLM_API_ENDPOINT=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ---- 方式二：阿里云百炼（通义千问，OpenAI 兼容接口）----
# 如需切换，取消下面注释并覆盖上面的 LLM_PROVIDER / KEY / ENDPOINT / MODEL
# LLM_PROVIDER=dashscope
# LLM_API_KEY=your_dashscope_api_key_here
# LLM_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_TEMPERATURE=0.7
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=3

# ---- 可选：并发与资源控制（也可用环境变量临时覆盖）----
# LLM_PARALLEL_WORKERS=4
# RULE_WORKERS=1
